{
  "name": "hosthtml",
  "version": "0.1.0",
  "private": true,
  "description": "HTML hosting site: upload, edit, open and share HTML pages. Google login, public/private, on Cloudflare Workers + D1 + R2.",
  "type": "module",
  "scripts": {
    "inline": "node scripts/inline.mjs",
    "predev": "node scripts/inline.mjs",
    "predeploy": "node scripts/inline.mjs",
    "build": "npm run typecheck && npm run inline",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute hosthtml-db --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute hosthtml-db --remote --file=./migrations/0001_init.sql",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-auth": "^1.2.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.14",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "wrangler": "4.119.0"
  }
}
